# ============================================================
# NINNA — variáveis de ambiente
# Copie este arquivo para ".env" e preencha. NUNCA suba o .env ao GitHub.
# ============================================================

# Porta do servidor
PORT=3000

# "development" ou "production". Em production, cookies ficam Secure (exige HTTPS)
# e o link de recuperação de senha NÃO é exibido na tela.
NODE_ENV=development

# Caminho do banco SQLite (será criado automaticamente)
DB_PATH=./data/ninna.db

# E-mail que vira ADMINISTRADORA ao se cadastrar (painel em #/admin)
ADMIN_EMAIL=

# ---------- Ninna AI (opcional) ----------
# Sem chave, a área de IA mostra o estado "não configurada".
# Chave da API da Anthropic (https://console.anthropic.com) — fica só no servidor.
ANTHROPIC_API_KEY=
# Modelo usado pela Ninna AI (confira os nomes atuais na documentação da Anthropic)
AI_MODEL=claude-sonnet-5-5
# Máximo de mensagens por usuária a cada 10 minutos
AI_RATE_LIMIT=20

# ---------- E-mail (recuperação de senha) ----------
# O projeto NÃO envia e-mails ainda. Veja server/lib/mailer.js para plugar um provedor.
# Em desenvolvimento, o link de recuperação aparece no console do servidor.
TRUST_PROXY=false   # true se estiver atrás de proxy (Render, Fly, Nginx...) para limitar por IP real
